---
// Bandeau de consentement cookies.
// Le site ne dépose qu'une seule famille de cookies : la mesure d'audience GA4,
// déclenchée comme un tag du conteneur GTM.
// Le RGPD (visiteurs européens — versions FR/EN) exige un consentement PRÉALABLE.
// Il est obtenu via le mode Consentement Google : le bootstrap dans Base.astro
// pose tout en « denied » AVANT le chargement de GTM, et expose ljdrLoadAnalytics
// que ce composant appelle au clic sur « Accepter ».
// La LGPD brésilienne est plus souple mais couverte par le même dispositif.
//
// Ce composant n'est rendu que si CONSENT_UI_ENABLED : hors production et hors
// preview de PR, aucun tag Google n'est posé, donc aucun bandeau à afficher.
import { CONSENT_KEY, type Locale } from '../config';
import { cookies } from '../i18n/ui';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = cookies[locale];
---
<div class="cookie-banner" data-cookie-banner data-key={CONSENT_KEY} hidden>
  {/* La barre porte le fond : elle traverse tout l'écran, de bord à bord, à
      n'importe quelle largeur. Le .wrap à l'intérieur ramène le texte et les
      boutons dans la colonne du site, alignés sur le reste des pages. */}
  <div
    class="cookie-banner__card"
    role="dialog"
    aria-modal="false"
    aria-labelledby="cookie-banner-title"
    tabindex="-1"
    data-cookie-card
  >
    <div class="wrap cookie-banner__inner">
      {/* Le corps est le seul élément qui défile : les boutons restent visibles,
          jamais poussés hors de l'écran par « En savoir plus » déplié sur un
          petit téléphone. */}
      <div class="cookie-banner__body">
        <h2 class="cookie-banner__title" id="cookie-banner-title">{t.title}</h2>
        <p class="cookie-banner__text">{t.text}</p>

        <details class="cookie-banner__more">
          <summary>{t.more}</summary>
          <p>{t.details}</p>
          <p>
            <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer">{t.policy}</a>
          </p>
        </details>
      </div>

      {/* Les deux boutons sont volontairement identiques (même style, même taille,
          même poids visuel) : la CNIL demande que refuser soit aussi immédiat
          qu'accepter — pas un lien discret à côté d'un bouton mis en avant. */}
      <div class="cookie-banner__actions">
        <button type="button" class="btn btn--primary" data-cookie-decline>{t.decline}</button>
        <button type="button" class="btn btn--primary" data-cookie-accept>{t.accept}</button>
      </div>
    </div>
  </div>
</div>

<script>
  // Pilotage du bandeau. Les helpers de consentement (lecture du choix, chargement
  // et révocation de GA) vivent dans le script inline du <head> — ils doivent
  // s'exécuter avant tout rendu, ce script-ci n'est que l'interface.
  const w = window as any;
  const banner = document.querySelector<HTMLElement>('[data-cookie-banner]');

  if (banner) {
    const key = banner.dataset.key || 'ljdr-consent';
    const card = banner.querySelector<HTMLElement>('[data-cookie-card]');
    const body = banner.querySelector<HTMLElement>('.cookie-banner__body');

    const save = (choice: 'granted' | 'denied') => {
      try {
        localStorage.setItem(key, JSON.stringify({ v: 1, choice, ts: Date.now() }));
      } catch {
        // Navigation privée / stockage refusé : le choix ne survit pas à la session,
        // le bandeau sera reproposé. On ne bloque surtout pas le visiteur pour autant.
      }
    };

    // Élément à qui rendre le focus quand le bandeau se referme (le lien « Cookies »
    // du pied de page). Sans ça, un visiteur au clavier repart de zéro en haut de page.
    let opener: HTMLElement | null = null;

    const show = (from: HTMLElement | null) => {
      opener = from;
      banner.hidden = false;
      // Réouverture depuis le pied de page : on repart du haut du texte, sinon
      // le bandeau réapparaît là où le visiteur avait laissé son défilement.
      if (body) body.scrollTop = 0;
      if (from) card?.focus();
    };
    const hide = () => {
      const hadFocus = banner.contains(document.activeElement);
      banner.hidden = true;
      if (hadFocus) opener?.focus();
      opener = null;
    };

    // Premier affichage : uniquement si aucun choix valide n'est enregistré
    // (jamais répondu, ou choix expiré au bout de 6 mois).
    if (typeof w.ljdrReadConsent === 'function' && w.ljdrReadConsent() === null) show(null);

    banner.querySelector('[data-cookie-accept]')?.addEventListener('click', () => {
      save('granted');
      w.ljdrLoadAnalytics?.();
      hide();
    });

    banner.querySelector('[data-cookie-decline]')?.addEventListener('click', () => {
      save('denied');
      w.ljdrRevokeAnalytics?.(); // couvre le cas « j'avais accepté, je change d'avis »
      hide();
    });

    // Lien « Cookies » du pied de page : rouvre le bandeau (retrait du consentement).
    for (const trigger of document.querySelectorAll('[data-cookie-open]')) {
      trigger.addEventListener('click', (e) => {
        e.preventDefault();
        show(trigger as HTMLElement);
      });
    }

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !banner.hidden) hide();
    });
  }
</script>
