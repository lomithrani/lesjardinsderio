---
// Séparateur de section en courbe asymétrique — la signature du site,
// écho des escaliers, arches et de la piscine de la maison.
interface Props {
  fill?: string;        // couleur de la forme (la section qui ARRIVE)
  flip?: boolean;       // miroir vertical
  class?: string;
}
const { fill = 'var(--creme)', flip = false, class: className = '' } = Astro.props;
---
<svg
  class={`curve ${className}`}
  viewBox="0 0 1440 110"
  preserveAspectRatio="none"
  aria-hidden="true"
  style={flip ? 'transform: scaleY(-1);' : undefined}
>
  <path
    d="M0,84 C220,118 420,18 760,42 C1040,62 1240,8 1440,54 L1440,110 L0,110 Z"
    fill={fill}
  />
</svg>
