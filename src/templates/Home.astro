---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import Carousel from '../components/Carousel.astro';
import CardLightbox from '../components/CardLightbox.astro';
import { image, cover, galleryOr } from '../images';
import { home, spaces, common } from '../i18n/ui';
import { photoAlt } from '../i18n/photos';
import { booking } from '../i18n/booking';
import { rooms } from '../i18n/rooms';
import { ROUTES, SITE, whatsappLink, type Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = home[locale];
const sp = spaces[locale];
const c = common[locale];
const b = booking[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
const teaser = rooms.slice(0, 3);
---
<Base locale={locale} page="home" title={t.metaTitle} description={t.metaDesc}>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__img">
      <Image src={image('photos/hero-maison-piscine')} alt={photoAlt('photos/hero-maison-piscine', locale)} widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap hero__content">
      <p class="eyebrow">{t.heroEyebrow}</p>
      <h1>{t.heroTitle}</h1>
      <p>{t.heroSub}</p>
      <div class="hero__actions">
        <a class="btn btn--light" href={url(ROUTES.rooms[locale])}>{c.checkAvailability}</a>
        <a class="btn btn--ghost" style="color: var(--blanc); border-color: var(--sable);" href={url(ROUTES.rooms[locale])}>{t.heroCtaRooms}</a>
      </div>
    </div>
    <Curve fill="var(--blanc)" class="curve--overlap" />
  </section>

  <!-- Intro / la maison -->
  <section class="section">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{t.introEyebrow}</p>
        <h2>{t.introTitle}</h2>
        <p>{t.introText1}</p>
        <p>{t.introText2}</p>
      </div>
      <div class="ph">
        <Image src={image('photos/interieur-perspective')} alt={photoAlt('photos/interieur-perspective', locale)} widths={[480, 800, 1200]} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <Curve fill="var(--creme)" />

  <!-- Espaces -->
  <section class="section section--creme" style="padding-top: 1rem;">
    <div class="wrap">
      <p class="eyebrow">{t.spacesEyebrow}</p>
      <h2>{t.spacesTitle}</h2>
      <p class="lede">{t.spacesIntro}</p>
      <div class="cards cards--3" style="margin-top: 2.2rem;">
        {sp.items.map((item: any) => (
          <article class="card" data-lightbox-card>
            <div class="card__img">
              <Carousel images={galleryOr(`spaces/${item.key}`, item.img)} alt={item.name} prevLabel={b.prevPhoto} nextLabel={b.nextPhoto} />
            </div>
            <div class="card__body">
              <h3>{item.name}</h3>
              <p>{item.desc}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Curve fill="var(--blanc)" />

  <!-- Chambres (teaser) -->
  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <p class="eyebrow">{t.roomsEyebrow}</p>
      <h2>{t.roomsTitle}</h2>
      <p class="lede">{t.roomsText}</p>
      <div class="cards cards--3" style="margin-top: 2.2rem;">
        {teaser.map((room) => (
          <article class="card">
            <div class="card__img">
              <Image src={cover(`rooms/${room.id}`)} alt={room.name[locale]} widths={[420, 720]} sizes="(min-width: 680px) 30vw, 92vw" />
            </div>
            <div class="card__body">
              {room.size && <span class="card__meta">{room.size} {c.sqm}</span>}
              <h3>{room.name[locale]}</h3>
              <a class="btn btn--ghost" href={url(ROUTES.rooms[locale])}>{c.discover}</a>
            </div>
          </article>
        ))}
      </div>
      <p style="margin-top: 2rem;"><a class="btn btn--primary" href={url(ROUTES.rooms[locale])}>{t.roomsCta}</a></p>
    </div>
  </section>

  <Curve fill="var(--vert)" />

  <!-- Événements -->
  <section class="section section--vert" style="padding-top: 1rem;">
    <div class="wrap split split--reverse">
      <div>
        <p class="eyebrow">{t.eventsEyebrow}</p>
        <h2>{t.eventsTitle}</h2>
        <p>{t.eventsText}</p>
        <a class="btn btn--light" href={url(ROUTES.events[locale])}>{t.eventsCta}</a>
      </div>
      <div class="ph ph--alt">
        <Image src={image('photos/piscine-jungle')} alt={photoAlt('photos/piscine-jungle', locale)} widths={[480, 800, 1200]} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <Curve fill="var(--blanc)" flip />

  <!-- Localisation -->
  <section class="section">
    <div class="wrap split">
      <div class="ph ph--soft">
        <Image src={image('photos/facade-palmiers')} alt={photoAlt('photos/facade-palmiers', locale)} widths={[480, 800, 1200]} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
      <div>
        <p class="eyebrow">{t.locationEyebrow}</p>
        <h2>{t.locationTitle}</h2>
        <p>{t.locationText}</p>
        <p>{SITE.addressLine1}<br />{SITE.addressLine2}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href={SITE.mapsUrl} rel="noopener">{t.locationCta}</a>
          <a class="btn btn--ghost" href={whatsappLink(locale)}>{c.writeWhatsApp}</a>
        </div>
      </div>
    </div>
  </section>
  <CardLightbox locale={locale} />
</Base>
