---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import { photo } from '../images';
import { experiences, common } from '../i18n/ui';
import { whatsappLink, type Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = experiences[locale];
const c = common[locale];
---
<Base locale={locale} page="experiences" title={t.metaTitle} description={t.metaDesc}>
  <section class="section section--creme" style="padding-bottom: 0.5rem;">
    <div class="wrap">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
    </div>
  </section>

  <Curve fill="var(--blanc)" />

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap cards cards--3">
      {t.items.map((item: any) => (
        <article class="card" id={item.key}>
          <div class="card__img">
            <Image src={photo(item.img)} alt={item.title} widths={[420, 720]} sizes="(min-width: 680px) 30vw, 92vw" />
          </div>
          <div class="card__body">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="btn btn--ghost" href={whatsappLink(locale, item.title)}>{c.writeWhatsApp}</a>
          </div>
        </article>
      ))}
    </div>
    <div class="wrap" style="margin-top: 2rem;">
      <p style="opacity: 0.75;">{t.note}</p>
    </div>
  </section>
</Base>
