---
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import Carousel from '../components/Carousel.astro';
import CardLightbox from '../components/CardLightbox.astro';
import { galleryOr } from '../images';
import { experiences, common } from '../i18n/ui';
import { booking } from '../i18n/booking';
import { ROUTES, type Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = experiences[locale];
const c = common[locale];
const b = booking[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
---
<Base locale={locale} page="experiences" title={t.metaTitle} description={t.metaDesc}>
  <section class="section section--creme" style="padding-bottom: 0.5rem;">
    <div class="wrap">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
    </div>
  </section>

  <Curve fill="var(--blanc)" class="curve--from-creme" />

  {/* Blocs éditoriaux « image + texte à côté », comme la maison sur la page d'accueil :
      un bloc sur deux passe sur fond crème et bascule la photo de l'autre côté. */}
  {t.items.map((item: any, i: number) => {
    const alt = i % 2 === 1;
    return (
      <Fragment>
        <section class:list={['section', { 'section--creme': alt }]} style="padding-top: 1rem;">
          <div class="wrap">
            <article class:list={['xp', 'split', { 'split--reverse': alt }]} id={item.key} data-lightbox-card>
              <div class:list={['card__img', { 'card__img--alt': alt }]}>
                <Carousel images={galleryOr(`experiences/${item.key}`, item.img)} alt={item.title} prevLabel={b.prevPhoto} nextLabel={b.nextPhoto} />
              </div>
              <div class="card__body">
                <h3>{item.title}</h3>
                <p>{item.text}</p>
                <a class="btn btn--ghost" href={url(ROUTES.contact[locale])}>{c.contactUs}</a>
              </div>
            </article>
          </div>
        </section>
        <Curve fill={alt ? 'var(--blanc)' : 'var(--creme)'} class={alt ? 'curve--from-creme' : ''} />
      </Fragment>
    );
  })}

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <p style="opacity: 0.75;">{t.note}</p>
      <p style="margin-top: 1.3rem;">
        <a class="btn btn--primary" href={url(ROUTES.contact[locale])}>{c.contactUs}</a>
      </p>
    </div>
  </section>
  <CardLightbox locale={locale} />
</Base>
