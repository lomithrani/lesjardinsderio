---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import EmailButton from '../components/EmailButton.astro';
import { image } from '../images';
import { events, common } from '../i18n/ui';
import { photoAlt } from '../i18n/photos';
import { SITE, whatsappLink, type Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = events[locale];
const c = common[locale];
const waContext: Record<Locale, string> = {
  pt: 'evento', en: 'event', fr: 'événement',
};
---
<Base locale={locale} page="events" title={t.metaTitle} description={t.metaDesc}>
  <section class="section section--creme" style="padding-bottom: 0.5rem;">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
        <p class="lede">{t.intro}</p>
      </div>
      <div class="ph">
        <Image src={image('photos/piscine-canopee')} alt={photoAlt('photos/piscine-canopee', locale)} widths={[480, 800, 1200]} sizes="(min-width: 820px) 45vw, 92vw" loading="eager" />
      </div>
    </div>
  </section>

  <Curve fill="var(--blanc)" />

  <!-- Texte éditorial : donne à la page un contenu rédigé (lieu, capacités, organisation)
       plutôt que deux listes à puces, pour le visiteur comme pour l'indexation. -->
  <section class="section" style="padding-top: 1rem; padding-bottom: 0;">
    <div class="wrap">
      <h2>{t.aboutTitle}</h2>
      {t.about.map((p: string) => (<p class="prose">{p}</p>))}
    </div>
  </section>

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap split">
      <div>
        <h2>{t.typesTitle}</h2>
        <ul class="list-cols">
          {t.types.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
      <div>
        <h2>{t.servicesTitle}</h2>
        <ul class="list-cols">
          {t.services.map((item: string) => <li>{item}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <Curve fill="var(--vert)" />

  <section class="section section--vert" style="padding-top: 1rem;">
    <div class="wrap split split--reverse">
      <div>
        <h2>{t.privatizationTitle}</h2>
        <p>{t.privatizationText}</p>
      </div>
      <div class="ph ph--alt">
        <Image src={image('photos/jardin-transats')} alt={photoAlt('photos/jardin-transats', locale)} widths={[480, 800]} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <Curve fill="var(--creme)" flip />

  <section class="section section--creme cta-band">
    <div class="wrap">
      <h2>{t.ctaTitle}</h2>
      <p class="lede" style="margin-inline: auto;">{t.ctaText}</p>
      <div class="cta-band__actions">
        <a class="btn btn--primary" href={whatsappLink(locale, waContext[locale])}>{c.writeWhatsApp}</a>
        <EmailButton locale={locale} context={waContext[locale]} variant="ghost" align="center" />
      </div>
      <p style="margin-top: 1rem; font-size: 0.92rem; opacity: 0.75;">
        <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
      </p>
    </div>
  </section>
</Base>
