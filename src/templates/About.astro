---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import { image } from '../images';
import { about } from '../i18n/about';
import { common } from '../i18n/ui';
import { ROUTES, type Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = about[locale];
const c = common[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (p: string) => `${base}${p}`;
---
<Base locale={locale} page="about" title={t.metaTitle} description={t.metaDesc}>
  <section class="section section--creme" style="padding-bottom: 0.5rem;">
    <div class="wrap split">
      <div>
        <p class="eyebrow">{t.eyebrow}</p>
        <h1>{t.title}</h1>
      </div>
      <div class="ph">
        <Image src={image(t.img)} alt="" widths={[480, 800, 1200]} sizes="(min-width: 820px) 45vw, 92vw" loading="eager" />
      </div>
    </div>
  </section>

  <Curve fill="var(--blanc)" class="curve--from-creme" />

  <!-- La maison, ses alentours (quartiers, plages) et l'accès — contenu dans src/i18n/about.ts. -->
  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      {t.intro.map((p: string) => (<p class="prose">{p}</p>))}
    </div>

    <div class="wrap" style="margin-top: 2.6rem;">
      <h2>{t.placesTitle}</h2>
      <div class="nearby">
        {t.places.map((place: any) => (
          <article class="nearby__item">
            <span class="card__meta">{place.meta}</span>
            <h4>{place.title}</h4>
            <p>{place.text}</p>
          </article>
        ))}
      </div>
    </div>

    <div class="wrap" style="margin-top: 2.6rem;">
      <h2>{t.beachesTitle}</h2>
      <p class="prose">{t.beachesText}</p>
      <div class="nearby nearby--tight">
        {t.beaches.map((beach: any) => (
          <article class="nearby__item">
            <span class="card__meta">{beach.meta}</span>
            <h4>{beach.title}</h4>
            <p>{beach.text}</p>
          </article>
        ))}
      </div>
      <p style="opacity: 0.75; margin-top: 1.2rem;">{t.beachesNote}</p>
    </div>

    <div class="wrap" style="margin-top: 2.6rem;">
      <h2>{t.accessTitle}</h2>
      <ul class="list-cols">
        {t.access.map((i: string) => (<li>{i}</li>))}
      </ul>
    </div>

    <div class="wrap" style="margin-top: 2rem;">
      <p class="prose">{t.closing}</p>
      <p style="margin-top: 1.3rem;">
        <a class="btn btn--primary" href={url(ROUTES.contact[locale])}>{c.contactUs}</a>
      </p>
    </div>
  </section>
</Base>
