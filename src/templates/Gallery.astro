---
import { Image, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { image } from '../images';
import { gallery } from '../i18n/ui';
import { photoAlt } from '../i18n/photos';
import type { Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = gallery[locale];

// Sélection et ordre d'affichage. Les descriptions vivent dans i18n/photos.ts,
// partagées avec les alt du reste du site et les vignettes de partage.
const shots = [
  'photos/piscine-maison',
  'photos/salon-large',
  'photos/allee-piscine',
  'photos/coin-art-rose',
  'photos/piscine-escalier',
  'photos/terrasse-coussins',
  'photos/jardin-aerien',
  'photos/piscine-arbres',
  'photos/terrasse-courbes',
  'photos/bar-interieur',
  'photos/piscine-jungle',
  'photos/terrasse-palmier',
  'photos/jardin-transats',
  'photos/piscine-jardin',
  'photos/courbes-ciel',
];

// Liens vers la version pleine taille optimisée
const fulls = await Promise.all(
  shots.map((id) => getImage({ src: image(id), width: 1600 }))
);
---
<Base locale={locale} page="gallery" title={t.metaTitle} description={t.metaDesc}>
  <section class="section section--creme" style="padding-bottom: 0.5rem;">
    <div class="wrap">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
    </div>
  </section>

  <section class="section" style="padding-top: 2rem;">
    <div class="wrap gallery">
      {shots.map((id, i) => (
        <a href={fulls[i].src} target="_blank" rel="noopener">
          <Image src={image(id)} alt={photoAlt(id, locale)} widths={[360, 600]} sizes="(min-width: 760px) 30vw, 46vw" loading={i < 3 ? 'eager' : 'lazy'} />
        </a>
      ))}
    </div>
  </section>
</Base>
