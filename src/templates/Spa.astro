---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Curve from '../components/Curve.astro';
import Carousel from '../components/Carousel.astro';
import CardLightbox from '../components/CardLightbox.astro';
import { image, galleryOr } from '../images';
import { spa, common } from '../i18n/ui';
import { booking } from '../i18n/booking';
import { whatsappLink, type Locale } from '../config';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = spa[locale];
const c = common[locale];
const b = booking[locale];
---
<Base locale={locale} page="spa" title={t.metaTitle} description={t.metaDesc}>
  <section class="section section--creme" style="padding-bottom: 0.5rem;">
    <div class="wrap">
      <p class="eyebrow">{t.eyebrow}</p>
      <h1>{t.title}</h1>
      <p class="lede">{t.lede}</p>
    </div>
  </section>

  <Curve fill="var(--blanc)" />

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap split">
      <div>
        <h2>{t.introTitle}</h2>
        <p>{t.introText}</p>
      </div>
      <div class="ph ph--alt">
        <Image src={image('photos/jardin-transats')} alt={t.introTitle} widths={[480, 760, 960]} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
    </div>
  </section>

  <section class="section" style="padding-top: 0;">
    <div class="wrap cards cards--3">
      {t.items.map((item: any) => (
        <article class="card" id={item.key} data-lightbox-card>
          <div class="card__img">
            <Carousel images={galleryOr(`spa/${item.key}`, item.img)} alt={item.title} prevLabel={b.prevPhoto} nextLabel={b.nextPhoto} />
          </div>
          <div class="card__body">
            <h3>{item.title}</h3>
            <p>{item.text}</p>
            <a class="btn btn--ghost" href={whatsappLink(locale, item.title)}>{c.writeWhatsApp}</a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <Curve fill="var(--vert)" />

  <section class="section section--vert">
    <div class="wrap split split--reverse">
      <div class="ph ph--soft">
        <Image src={image('photos/piscine-canopee')} alt={t.dayuseTitle} widths={[480, 760, 960]} sizes="(min-width: 820px) 45vw, 92vw" />
      </div>
      <div>
        <p class="eyebrow">{t.dayuseEyebrow}</p>
        <h2>{t.dayuseTitle}</h2>
        <p>{t.dayuseText}</p>
        <ul class="list-cols">
          {t.includes.map((i: string) => (<li>{i}</li>))}
        </ul>
        <p style="margin-top: 1.3rem;">
          <a class="btn btn--primary" href={whatsappLink(locale, t.dayuseTitle)}>{c.writeWhatsApp}</a>
        </p>
      </div>
    </div>
  </section>

  <Curve fill="var(--blanc)" />

  <section class="section" style="padding-top: 1rem;">
    <div class="wrap">
      <p style="opacity: 0.75;">{t.note}</p>
    </div>
  </section>
  <CardLightbox locale={locale} />
</Base>
