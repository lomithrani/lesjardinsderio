---
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { SITE, ROUTES, LOCALES, HTML_LANG, OG_LOCALE, whatsappLink, STAGING_NOINDEX, GOOGLE_SITE_VERIFICATION, GTM_ENABLED, GTM_ID, CONSENT_UI_ENABLED, CONSENT_KEY, CONSENT_MAX_AGE, type Locale } from '../config';
import { nav, common, cookies } from '../i18n/ui';
import { image, cover } from '../images';
import { photoAlt } from '../i18n/photos';
import { rooms } from '../i18n/rooms';
import CookieBanner from '../components/CookieBanner.astro';

interface Props {
  locale: Locale;
  page: keyof typeof ROUTES; // clé logique de la page (home, rooms, …)
  title: string;
  description: string;
}
const { locale, page, title, description } = Astro.props;

const t = nav[locale];
const c = common[locale];
const ck = cookies[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;
const abs = (path: string) => new URL(`${base}${path}`, Astro.site).href;

const current = ROUTES[page];
const canonical = abs(current[locale]);

// ── Vignette de partage (Open Graph) ────────────────────────────────────────
// Une photo par page : un lien vers /evenements partagé sur WhatsApp doit montrer
// la piscine sous la canopée, pas la façade. Les IDs pointent vers assets-src/ ;
// `image()` échoue au build si l'un d'eux disparaît — la vignette ne peut donc
// pas se casser en silence.
// La description de la photo (i18n/photos.ts) sert d'og:image:alt : c'est l'image
// qu'elle doit décrire, pas la page. Les photos de chambres n'y figurent pas —
// elles retombent sur la description de la page, faute de mieux.
const fromPhoto = (id: string) => ({ src: image(id), alt: photoAlt(id, locale) });

const OG_IMAGES: Record<keyof typeof ROUTES, { src: ImageMetadata; alt: string }> = {
  home: fromPhoto('photos/hero-maison-piscine'),
  rooms: { src: cover('rooms/presidential-white', 'photos/interieur-perspective'), alt: description },
  spa: fromPhoto('photos/jardin-transats'),
  events: fromPhoto('photos/piscine-canopee'),
  experiences: fromPhoto('photos/jardin-aerien'),
  gallery: fromPhoto('photos/piscine-jardin'),
  contact: fromPhoto('photos/facade-palmiers'),
  terms: fromPhoto('photos/piscine-escalier'),
};

// 1200 × 630 (ratio 1.91:1) : le format attendu par Facebook, WhatsApp, LinkedIn
// et X. Recadrage centré plutôt que déformation. En JPEG — WhatsApp n'affiche pas
// les vignettes WebP de façon fiable, alors qu'Astro sert du WebP par défaut.
const ogAsset = await getImage({
  src: OG_IMAGES[page].src,
  width: 1200,
  height: 630,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
});

// Les URL d'assets produites par Astro portent DÉJÀ le préfixe `base` : les passer
// à `abs()` (qui le rajoute) donnerait /preview/pr-12/preview/pr-12/_astro/…
const ogImage = new URL(ogAsset.src, Astro.site).href;

const navItems: Array<[keyof typeof ROUTES, string]> = [
  ['home', t.home],
  ['rooms', t.rooms],
  ['experiences', t.experiences],
  ['spa', t.spa],
  ['events', t.events],
  ['contact', t.contact],
];

const year = new Date().getFullYear();

// Marqueur de build : SHA du commit (injecté par GitHub Actions) + horodatage.
// Permet au job `verify` du workflow de confirmer que le site en ligne sert bien ce commit.
const buildInfo = `${(process.env.GITHUB_SHA ?? 'local').slice(0, 7)} ${new Date().toISOString()}`;

// Snippet Google Tag Manager, repris tel quel. On l'injecte via `set:html` plutôt
// que de l'écrire dans le template : dans une expression Astro ({cond && …}), les
// accolades du script seraient prises pour du code.
const gtmSnippet = `(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','${GTM_ID}');`;

// ── Données structurées (JSON-LD) ───────────────────────────────────────────
// Un @graph plutôt que des blocs isolés : les nœuds se référencent par @id, si
// bien que Google comprend que la salle d'événements et les suites appartiennent
// à CET établissement, et pas à trois entités homonymes.
//
// Règle de rédaction : rien ici ne doit être inventé. Chaque valeur est reprise
// du contenu du site, de src/config.ts ou de la fiche Google du lieu. Un schéma
// qui contredit la page est pénalisé — mieux vaut un champ absent que faux.
//
// ⛑ À FAIRE CONFIRMER PAR LA CLIENTE, puis ajouter ici :
//   priceRange (ex. 'R$$$'), checkinTime / checkoutTime, starRating.
//   Ces trois champs alimentent Google Hotels ; on les laisse vides tant que la
//   valeur exacte n'est pas connue.
const homeUrl = abs(ROUTES.home[locale]);
const hotelId = `${homeUrl}#hotel`;

const postalAddress = {
  '@type': 'PostalAddress',
  streetAddress: 'Rua Cosme Velho, 1342',
  addressLocality: 'Rio de Janeiro',
  addressRegion: 'RJ',
  postalCode: '22241-091',
  addressCountry: 'BR',
};

// Photo de l'établissement, en 16:9 — le ratio que Google privilégie pour les
// résultats enrichis. Distincte de la vignette de partage (1.91:1), et identique
// sur toutes les pages : c'est la maison qu'elle représente, pas la page.
const hotelPhoto = await getImage({
  src: image('photos/hero-maison-piscine'),
  width: 1200,
  height: 675,
  fit: 'cover',
  position: 'center',
  format: 'jpeg',
});

const hotel = {
  '@type': 'BedAndBreakfast',
  '@id': hotelId,
  name: SITE.name,
  url: homeUrl,
  image: new URL(hotelPhoto.src, Astro.site).href,
  telephone: SITE.phoneHref.replace('tel:', ''),
  email: SITE.email,
  address: postalAddress,
  // Coordonnées du marqueur de la fiche Google du lieu (cf. SITE.mapsUrl).
  geo: { '@type': 'GeoCoordinates', latitude: -22.941071, longitude: -43.2062929 },
  hasMap: SITE.mapsUrl,
  sameAs: [SITE.instagram],
  // Dérivé de la liste des suites : impossible de désynchroniser le schéma du site.
  numberOfRooms: rooms.length,
  // Horaires de la réception, tels qu'annoncés sur la page Contact.
  openingHoursSpecification: [{
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
    opens: '09:00',
    closes: '17:00',
  }],
  amenityFeature: [
    { '@type': 'LocationFeatureSpecification', name: 'Swimming pool', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Tropical garden', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Rooftop', value: true },
    { '@type': 'LocationFeatureSpecification', name: 'Bar', value: true },
  ],
  additionalType: 'https://schema.org/EventVenue',
};

const website = {
  '@type': 'WebSite',
  '@id': `${homeUrl}#website`,
  url: homeUrl,
  name: SITE.name,
  inLanguage: HTML_LANG[locale],
  publisher: { '@id': hotelId },
};

// Fil d'Ariane : la navigation est plate, donc deux niveaux au plus. Google
// l'affiche à la place de l'URL nue dans les résultats.
const breadcrumb = page === 'home' ? null : {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: t.home, item: homeUrl },
    { '@type': 'ListItem', position: 2, name: t[page], item: canonical },
  ],
};

// Nœuds propres à certaines pages, là où le contenu le justifie.
const pageNodes: Record<string, object[]> = {
  events: [{
    '@type': 'EventVenue',
    '@id': `${canonical}#venue`,
    name: SITE.name,
    url: canonical,
    address: postalAddress,
    // « la casa inteira pode ser privatizada para celebrações de até 500 convidados »
    maximumAttendeeCapacity: 500,
    photo: ogImage,
  }],
  rooms: rooms.map((room) => ({
    '@type': 'HotelRoom',
    name: room.name[locale],
    description: room.desc[locale],
    containedInPlace: { '@id': hotelId },
    // MTK = mètre carré (code d'unité UN/CEFACT). Absent quand la surface n'a
    // pas encore été validée par la cliente (cf. src/i18n/rooms.ts).
    ...(room.size ? { floorSize: { '@type': 'QuantitativeValue', value: room.size, unitCode: 'MTK' } } : {}),
  })),
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [hotel, website, ...(breadcrumb ? [breadcrumb] : []), ...(pageNodes[page] ?? [])],
};
---
<!doctype html>
<html lang={HTML_LANG[locale]}>
  <head>
    <meta charset="utf-8" />
    {/* ORDRE CRITIQUE — le bootstrap du Mode Consentement ci-dessous doit
        s'exécuter AVANT le chargement de GTM : il pose les valeurs par défaut
        (tout « denied ») que les tags du conteneur sont censés respecter. Si
        GTM démarrait en premier, ses tags pourraient se déclencher avant, et
        le bandeau ne serait plus qu'un décor. Ne pas intervertir ces deux blocs. */}
    {CONSENT_UI_ENABLED && (
      <script is:inline define:vars={{ consentKey: CONSENT_KEY, consentMaxAge: CONSENT_MAX_AGE }}>
        // Mode Consentement Google (v2). Tout est refusé par défaut, et gtag.js n'est
        // même pas téléchargé tant que le visiteur n'a pas accepté : le RGPD exige un
        // consentement PRÉALABLE au dépôt (les visiteurs FR/EN y sont soumis ; la LGPD
        // brésilienne est plus souple mais couverte par le même dispositif).
        // Ce script doit rester inline et en tête : il s'exécute avant tout rendu.
        window.dataLayer = window.dataLayer || [];
        function gtag() { window.dataLayer.push(arguments); }
        window.gtag = gtag;
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500,
        });

        // Appelé au clic sur « Accepter », ou d'emblée si le choix est déjà
        // enregistré — auquel cas ce script s'exécutant avant GTM, le conteneur
        // démarre directement avec le consentement accordé.
        // Aucun script n'est injecté ici : GA4 est un tag DU conteneur GTM, qui
        // lit ce signal. Idempotent, le visiteur pouvant refuser puis ré-accepter
        // sans recharger la page.
        window.ljdrLoadAnalytics = function () {
          gtag('consent', 'update', { analytics_storage: 'granted' });
        };

        // Retrait du consentement : on repasse en « denied » et on efface les cookies
        // GA déjà posés (sur l'hôte comme sur le domaine parent, GA utilisant les deux).
        window.ljdrRevokeAnalytics = function () {
          gtag('consent', 'update', { analytics_storage: 'denied' });
          // GA pose son cookie sur le domaine principal, qui n'est pas forcément
          // l'hôte courant (www.exemple.com → .exemple.com). On tente donc l'hôte
          // puis chacun de ses parents ; les suffixes publics sont rejetés par le
          // navigateur, sans dommage.
          var parts = location.hostname.split('.');
          var scopes = [''];
          for (var i = 0; i < parts.length - 1; i++) {
            var d = parts.slice(i).join('.');
            scopes.push('; domain=' + d, '; domain=.' + d);
          }
          document.cookie.split(';').forEach(function (raw) {
            var name = raw.split('=')[0].trim();
            if (name.indexOf('_ga') !== 0 && name !== '_gid') return;
            scopes.forEach(function (scope) {
              document.cookie = name + '=; Max-Age=0; path=/' + scope;
            });
          });
        };

        // Choix enregistré, ou null si absent/expiré (→ le bandeau se réaffiche).
        window.ljdrReadConsent = function () {
          try {
            var raw = localStorage.getItem(consentKey);
            if (!raw) return null;
            var saved = JSON.parse(raw);
            if (!saved || typeof saved.ts !== 'number' || Date.now() - saved.ts > consentMaxAge) {
              localStorage.removeItem(consentKey);
              return null;
            }
            return saved.choice === 'granted' ? 'granted' : 'denied';
          } catch (e) {
            return null;
          }
        };

        if (window.ljdrReadConsent() === 'granted') window.ljdrLoadAnalytics();
      </script>
    )}
    {/* Google Tag Manager. is:inline est indispensable : sans lui, Astro sortirait
        le snippet de l'en-tête pour le regrouper dans un bundle chargé plus tard. */}
    {GTM_ENABLED && <script is:inline set:html={gtmSnippet} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="google-site-verification" content={GOOGLE_SITE_VERIFICATION} />
    <link rel="canonical" href={canonical} />
    {STAGING_NOINDEX && <meta name="robots" content="noindex" />}
    <meta name="build" content={buildInfo} />
    {LOCALES.map((l) => (
      <link rel="alternate" hreflang={HTML_LANG[l]} href={abs(current[l])} />
    ))}
    <link rel="alternate" hreflang="x-default" href={abs(current.pt)} />
    <link rel="icon" type="image/svg+xml" href={url('/logo-noir.svg')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:image" content={ogImage} />
    {/* Largeur et hauteur déclarées : sans elles, les aperçus WhatsApp et Facebook
        n'apparaissent qu'au SECOND partage, le temps que le robot aille chercher
        l'image et en mesure les dimensions lui-même. */}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={OG_IMAGES[page].alt} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    {LOCALES.filter((l) => l !== locale).map((l) => (
      <meta property="og:locale:alternate" content={OG_LOCALE[l]} />
    ))}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Karla:wght@400;700&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    {/* Google Tag Manager (noscript) */}
    {GTM_ENABLED && (
      <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${GTM_ID}`}
        height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    )}

    <a class="skip-link" href="#main">Skip to content</a>

    {/* Placé en tête du <body> — le bandeau est en position fixed, l'affichage ne
        bouge pas, mais le choix devient le premier élément atteint au clavier et
        par un lecteur d'écran, au lieu d'arriver après tout le pied de page. */}
    {CONSENT_UI_ENABLED && <CookieBanner locale={locale} />}

    <header class="site-header">
      <div class="wrap site-header__in">
        <a class="brand" href={url(ROUTES.home[locale])}>
          <img src={url('/logo-noir.svg')} alt="" width="84" height="84" />
          <span>Les Jardins de Rio</span>
        </a>

        <button class="nav-toggle" aria-expanded="false" aria-controls="site-nav">Menu</button>

        <nav class="site-nav" id="site-nav" aria-label="Main">
          <ul>
            {navItems.map(([key, label]) => (
              <li>
                <a href={url(ROUTES[key][locale])} aria-current={key === page ? 'page' : undefined}>{label}</a>
              </li>
            ))}
            <li class="lang" aria-label="Languages">
              {LOCALES.map((l) => (
                <a href={url(current[l])} aria-current={l === locale ? 'true' : undefined} lang={HTML_LANG[l]}>{l.toUpperCase()}</a>
              ))}
            </li>
            <li>
              <a class="btn btn--primary" href={url(ROUTES.rooms[locale])}>{t.book}</a>
            </li>
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="site-footer__grid">
          <div>
            <a class="brand" href={url(ROUTES.home[locale])}>
              <img src={url('/logo-noir.svg')} alt="" width="84" height="84" />
              <span>Les Jardins de Rio</span>
            </a>
            <p>{c.footerTagline}</p>
            <p>{SITE.addressLine1}<br />{SITE.addressLine2}</p>
          </div>
          <div>
            <ul>
              {navItems.map(([key, label]) => (
                <li><a href={url(ROUTES[key][locale])}>{label}</a></li>
              ))}
              {/* Page légale : elle vit ici et sur la page Chambres, pas dans la
                  navigation principale — mais elle doit rester à un clic depuis
                  n'importe quelle page. */}
              <li><a href={url(ROUTES.terms[locale])}>{t.terms}</a></li>
            </ul>
          </div>
          <div>
            <ul>
              <li><a href={whatsappLink(locale)}>WhatsApp · {SITE.mobile}</a></li>
              <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li><a class="social-link" href={SITE.instagram} rel="noopener" aria-label="Instagram">
                <svg class="social-link__icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="2" y="2" width="20" height="20" rx="5.5" />
                  <circle cx="12" cy="12" r="4.2" />
                  <circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" />
                </svg>
              </a></li>
            </ul>
          </div>
        </div>
        <div class="site-footer__bottom">
          <span>© {year} Les Jardins de Rio. {c.rights}</span>
          <span>
            {c.footerNote}
            {CONSENT_UI_ENABLED && (
              <>
                {' · '}
                <button type="button" class="cookie-reopen" data-cookie-open>{ck.manage}</button>
              </>
            )}
          </span>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.querySelector('.nav-toggle');
      const navEl = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const open = navEl?.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(!!open));
      });
    </script>
  </body>
</html>
