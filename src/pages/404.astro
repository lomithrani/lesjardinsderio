---
// Page 404 — volontairement autonome, sans le layout Base.
//
// GitHub Pages sert ce fichier (dist/404.html) pour TOUTE URL inconnue du
// domaine, quelle que soit la langue du chemin demandé : /fr/pas-de-page comme
// /pt/inexistente aboutissent au même document, avec un vrai statut HTTP 404.
// On ne peut donc pas choisir une langue au build. Les trois versions sont
// écrites dans la page, et un script en révèle une seule — d'où l'abandon de
// Base.astro, dont l'en-tête et le pied de page seraient restés figés en
// portugais au-dessus d'un contenu passé en français.
//
// Pas de GTM ni de bandeau cookies ici : le consentement se demande sur les
// pages du site, pas sur un cul-de-sac. Le revers est que les liens morts
// n'apparaissent pas dans GA4 ; c'est la Search Console qui les signale.
import '../styles/global.css';
import { Image } from 'astro:assets';
import { image } from '../images';
import { LOCALES, HTML_LANG, ROUTES, DEFAULT_LOCALE, SITE } from '../config';
import { notFound, nav } from '../i18n/ui';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (path: string) => `${base}${path}`;

const navKeys: Array<keyof typeof ROUTES> = ['home', 'rooms', 'experiences', 'spa', 'events', 'contact'];
---
<!doctype html>
<html lang={HTML_LANG[DEFAULT_LOCALE]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — {SITE.name}</title>
    {/* Le statut HTTP 404 servi par GitHub Pages suffirait à écarter la page des
        résultats ; la balise ne coûte rien et couvre le cas d'un hébergeur qui
        renverrait 200 par erreur. */}
    <meta name="robots" content="noindex" />
    <link rel="icon" type="image/svg+xml" href={url('/logo-noir.svg')} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Marcellus&family=Karla:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="nf">
      <div class="nf__img">
        <Image src={image('photos/piscine-escalier')} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" fetchpriority="high" />
      </div>

      <div class="wrap nf__content">
        <a class="brand nf__brand" href={url(ROUTES.home[DEFAULT_LOCALE])}>
          <img src={url('/logo-noir.svg')} alt={SITE.name} width="84" height="84" />
        </a>

        <p class="nf__code" aria-hidden="true">404</p>

        {LOCALES.map((l) => (
          <div class="nf__block" data-loc={l} lang={HTML_LANG[l]} hidden={l !== DEFAULT_LOCALE}>
            <h1>{notFound[l].title}</h1>
            <p class="nf__text">{notFound[l].text}</p>
            <p class="nf__actions">
              <a class="btn btn--light" href={url(ROUTES.home[l])}>{notFound[l].home}</a>
            </p>
            <p class="nf__elsewhere">{notFound[l].elsewhere}</p>
            <ul class="nf__links">
              {navKeys.filter((key) => key !== 'home').map((key) => (
                <li><a href={url(ROUTES[key][l])}>{nav[l][key]}</a></li>
              ))}
            </ul>
          </div>
        ))}

        {/* Sélecteur de langue : utile quand la détection se trompe, et seul
            recours si le script ne s'exécute pas. */}
        <ul class="nf__langs" aria-label="Languages">
          {LOCALES.map((l) => (
            <li><a href={url(ROUTES.home[l])} lang={HTML_LANG[l]}>{l.toUpperCase()}</a></li>
          ))}
        </ul>
      </div>
    </main>

    {/* is:inline et placé juste après les blocs : le script s'exécute pendant le
        parsing, donc avant le premier rendu. Un script Astro classique serait
        bundlé en module différé, et le visiteur francophone verrait le bloc
        portugais clignoter avant d'être remplacé. */}
    <script is:inline>
      (function () {
        // La langue voulue se lit dans le chemin qui a échoué (/fr/…, /pt/…),
        // seul indice disponible : le serveur, lui, a déjà rendu son verdict.
        var match = location.pathname.match(/\/(pt|en|fr)(\/|$)/);
        var wanted = match ? match[1] : (navigator.language || '').slice(0, 2).toLowerCase();
        // 'pt-PT' comme 'pt-BR' donnent 'pt' ; toute autre langue retombe sur le
        // portugais déjà affiché, cohérent avec le x-default du site.
        var block = document.querySelector('[data-loc="' + wanted + '"]');
        if (!block || !block.hidden) return;

        document.querySelectorAll('[data-loc]').forEach(function (el) {
          el.hidden = el !== block;
        });
        document.documentElement.lang = block.getAttribute('lang');
      })();
    </script>

    <style>
      .nf {
        position: relative;
        isolation: isolate;
        min-height: 100vh;
        min-height: 100svh;
        display: grid;
        align-items: center;
        color: var(--blanc);
        text-align: center;
      }
      .nf__img, .nf__img img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: -2;
      }
      .nf::after {
        content: '';
        position: absolute;
        inset: 0;
        z-index: -1;
        background: linear-gradient(180deg, rgba(20, 32, 26, 0.55), rgba(20, 32, 26, 0.78));
      }
      .nf__content { padding-block: clamp(3rem, 10vh, 6rem); }
      .nf__brand { display: inline-block; }
      .nf__brand img { filter: brightness(0) invert(1); width: 68px; height: 68px; }
      .nf__code {
        font-family: var(--font-display);
        font-size: clamp(3.5rem, 14vw, 7rem);
        line-height: 1;
        margin: 0.4rem 0 0.6rem;
        color: var(--sable);
        opacity: 0.65;
      }
      .nf__block h1 { color: var(--blanc); }
      .nf__text {
        color: var(--sable);
        font-size: 1.12rem;
        max-width: 34rem;
        margin-inline: auto;
      }
      .nf__actions { margin-top: 1.6rem; }
      .nf__elsewhere {
        margin-top: 2.6rem;
        color: var(--sable);
        font-size: 0.92rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
      }
      .nf__links, .nf__langs {
        list-style: none;
        padding: 0;
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 0.4rem 1.4rem;
      }
      .nf__links { margin: 0.7rem 0 0; }
      .nf__links a, .nf__langs a { color: var(--blanc); text-decoration: none; border-bottom: 1px solid transparent; }
      .nf__links a:hover, .nf__langs a:hover { border-bottom-color: var(--or); }
      .nf__langs {
        margin: 3rem 0 0;
        gap: 0.4rem 1rem;
        font-size: 0.85rem;
        letter-spacing: 0.12em;
        opacity: 0.7;
      }
    </style>
  </body>
</html>
